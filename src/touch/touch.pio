; Single-pin capacitive touch sensing for the RP2040.
;
; One state machine per touch pad. Each pad connects to a GPIO with a ~1M ohm
; resistor to ground. The program charges the pad HIGH through the output
; driver, releases it to a high-impedance input, then counts PIO cycles until
; it discharges below the logic threshold. A finger on the pad adds
; capacitance, slowing the discharge and raising the count.
;
; The CPU triggers a measurement by writing the timeout value to the TX FIFO.
; The SM pushes the remaining count to the RX FIFO (0 on timeout). Elapsed
; time = timeout - remaining, so the CPU never has to busy-wait for timing.

.program capsense
.wrap_target
begin:
    pull block              ; wait for a trigger; OSR holds the timeout value
    mov x, osr              ; X = timeout count
    set pindirs, 1          ; pad -> output
    set pins, 1             ; drive pad HIGH to charge it
    nop [7]                 ; let the charge settle
    set pindirs, 0          ; pad -> input (high-Z); pad still reads HIGH
count:
    jmp x-- check           ; X != 0 -> decrement and check the pin
    jmp timeout             ; X hit 0: the pad never discharged
check:
    jmp pin count           ; pad still HIGH -> keep counting
    mov isr, x              ; pad went LOW: push the remaining count
    push block
    jmp begin               ; back to wait for the next trigger
timeout:
    mov isr, null           ; 0 sentinel so the CPU can spot a saturated reading
    push block
    jmp begin
.wrap
